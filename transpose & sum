#include<stdio.h>
#define MAX 50

int s[MAX][3],a[MAX][3],b[MAX][3],t[MAX][3];

void read(int p[MAX][3]){
    int i;
    printf("enter no of rows,column,no of non zero elements:\n");
    scanf("%d %d %d",&p[0][0],&p[0][1],&p[0][2]);

    printf("enter row,column,elements:\n");
    for(i=1;i<=p[0][2];i++){
        scanf("%d %d %d",&p[i][0],&p[i][1],&p[i][2]);
    }
}

void display(int p[MAX][3]){
    printf("Row Column Element\n");

    for(int i=0;i<=p[0][2];i++){
        printf("%d %d %d\n",p[i][0],p[i][1],p[i][2]);
    }
}

void add(){
    int i=1,j=1,k=1;
    int sum;

    s[0][0]=a[0][0];
    s[0][1]=a[0][1];

    while(i<=a[0][2] && j<=b[0][2]){
        if(a[i][0]==b[j][0] && a[i][1]==b[j][1]){
            sum=a[i][2]+b[j][2];

            if(sum!=0){
                s[k][0]=a[i][0];
                s[k][1]=a[i][1];
                s[k][2]=sum;
                k++;
            }

            i++;
            j++;
        }

        else if(a[i][0]<b[j][0] ||
        (a[i][0]==b[j][0] && a[i][1]<b[j][1])){
            s[k][0]=a[i][0];
            s[k][1]=a[i][1];
            s[k][2]=a[i][2];

            i++;
            k++;
        }

        else{
            s[k][0]=b[j][0];
            s[k][1]=b[j][1];
            s[k][2]=b[j][2];

            j++;
            k++;
        }
    }

    while(i<=a[0][2]){
        s[k][0]=a[i][0];
        s[k][1]=a[i][1];
        s[k][2]=a[i][2];

        k++;
        i++;
    }

    while(j<=b[0][2]){
        s[k][0]=b[j][0];
        s[k][1]=b[j][1];
        s[k][2]=b[j][2];

        k++;
        j++;
    }

    s[0][2]=k-1;
}

void transpose(){
    int i,j,k=1;

    t[0][0]=s[0][1];
    t[0][1]=s[0][0];
    t[0][2]=s[0][2];

    for(i=0;i<s[0][1];i++){
        for(j=1;j<=s[0][2];j++){
            if(s[j][1]==i){
                t[k][0]=s[j][1];
                t[k][1]=s[j][0];
                t[k][2]=s[j][2];

                k++;
            }
        }
    }
}

int main(){
    printf("enter first matrix:\n");
    read(a);

    printf("enter second matrix:\n");
    read(b);

    if(a[0][0]!=b[0][0] || a[0][1]!=b[0][1]){
        printf("addition not possible\n");
        return 0;
    }

    add();

    printf("sum=\n");
    display(s);

    transpose();

    printf("transpose=\n");
    display(t);

    return 0;
}
