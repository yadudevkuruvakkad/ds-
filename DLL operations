void reverse(){
    struct node *current,*nextnode;
    if(head==0){
        printf("empty stack\n");
    }
    else{
        current=head;
        while(current!=0){
            nextnode=current->next;
            current->next=current->prev;
            current->prev=nextnode;
        current=nextnode;}
        current=head;
        head=tail;
        tail=current;
    }}
