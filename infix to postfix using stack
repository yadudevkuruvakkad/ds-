#include <stdio.h>
#include<string.h>
#include<ctype.h>
#define MAX 100
int top=-1;
char stack[MAX];
void push(char x){
    stack[++top]=x;
}
int pop(){
    return stack[top--];
}
int precedence(int ch){
        if(ch=='^')
            return 3;
        else if(ch=='*'||ch=='/'||ch=='%')
            return 2;
        else if(ch=='+'||ch=='-')
            return 1;
        else
            return 0;
    
    }

void infixtopstfix(char infix[]){
    char postfix[MAX];
    int i,j=0;
    for(i=0;infix[i]!='\0';i++){
        char ch=infix[i];
    if(isalnum(ch)){
        postfix[j++]=ch;
    }
    else if(ch=='('){
        push(ch);}
    else if(ch==')'){
        if(top!=-1 && stack[top]!='('){
            postfix[j++]=pop();}
        pop();
    }
     else{
         if(top!=-1&&stack[top]!='(' && (precedence(stack[top])>precedence(ch)) || (precedence(stack[top])==precedence(ch)) && stack[top]!='^'){
             postfix[j++]=pop();
         }push(ch);}}

        while(top!=-1){
            postfix[j++]=pop();}
        postfix[j]='\0';
        printf("postfix expression=%s\n",postfix);}
int main(){
    char infix[MAX];
    printf("enter your infix exp:\n");
    scanf("%s",infix);
    infixtopstfix(infix);
}
         
    
