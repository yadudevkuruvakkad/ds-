#include<stdio.h>
int a[50][50],visited[50];
int front=-1;
int rear=-1;
int queue[50];
void  add_vertex(int n){
    int u,v;
    printf("enter source vertex:\n");
    scanf("%d",&u);
    printf("enter destination vertes:\n");
    scanf("%d",&v);
    if(u<0||u>=n||v<0||u>=n){
        printf("invalid vertex");
    }else{
    a[u][v]=1;
    a[v][u]=1;
}printf("node added successfully\n");
}

void display(int n){
    int i=0;
    int j=0;
    for(i=0;i<n;i++){
        for(j=0;j<n;j++){
            printf("%d",a[i][j]);
        }printf("\n");}}

void bfs(int start,int n){
    int v;
    front=rear=-1;
    queue[++rear]=start;
    visited[start]=1;
    while(front!=rear){
        v=queue[++front];
        printf("%d\t",v);
    for(int i=0;i<n;i++){
        if(a[v][i]==1&&visited[i]==0){
            queue[++rear]=i;
            visited[i]=1;
        }}
    }}

void dfs(int v,int n){
    visited[v]=1;
    printf(" %d ",v);
    for(int i=0;i<n;i++){
        if(a[v][i]==1&&visited[i]==0){
            dfs(i,n);}}}

int main(){
    int choice;
    int n;
    printf("enter no of edges in graph:");
    scanf("%d",&n);
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            a[i][j]=0;}}
    do{
        printf("\n<<<<operation menu>>>>\n");
        printf("1.add edge\n2.display\n3.BFS traversal\n4.DFS traversal\n5.exit\nENTER YOUR CHOICE:\n");
        scanf("%d",&choice);
        switch(choice){
            case 1:
            add_vertex(n);break;
            case 2:
            display(n);break;
            case 3:
            int x;
            printf("enter starting vertex:\n");
            scanf("%d",&x);
            if(x<0||x>=n){
                printf("invalid start:\n");
            }
            for(int i=0;i<n;i++){
                visited[i]=0;}
            printf("bfs traversal:");
            bfs(x,n);
            break;
            case 4:
            printf("enter starting vertex:\n");
            scanf("%d",&x);
            if(x<0||x>=n){
                printf("invalid start:\n");
            }
            for(int i=0;i<n;i++){
                visited[i]=0;}
            printf("dfs traversal:");
            dfs(x,n);
            break;
            case 5:
            printf("exiting program..\n");
            break;
            default:
            printf("invalid choice\n");
        }}while(choice!=5);}
